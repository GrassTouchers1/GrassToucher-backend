# ==============================================================================
# HỆ THỐNG GIÁM SÁT THIÊN TAI & ĐIỀU PHỐI CỨU NẠN NORTHSTAR / FLOODNAV
# Tệp mẫu cấu hình biến môi trường (.env.example)
#
# LƯU Ý BẢO MẬT QUAN TRỌNG:
# 1. Sao chép tệp này thành .env trước khi chạy: cp .env.example .env
# 2. TUYỆT ĐỐI KHÔNG commit tệp .env chứa API Key thực tế lên Git/GitHub.
# 3. Tệp .env đã được cấu hình trong .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cấu hình Cơ sở dữ liệu (PostGIS / PostgreSQL)
# Ghi chú: app/db.py đọc trực tiếp biến DATABASE_URL (mặc định fallback sang SQLite
# nếu không kết nối được PostgreSQL). Các biến POSTGRES_* bên dưới chỉ mang tính
# tham khảo cho script/container ngoài, app/db.py không tự ghép từ các biến rời.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/floodnav
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=floodnav
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_db_password_here

# ------------------------------------------------------------------------------
# 2. Cấu hình AI Provider (Groq API / Pluggable LLM Layer)
# Dự án hoạt động 100% mã nguồn mở. Groq API là tùy chọn, không bắt buộc.
# Khi mất kết nối hoặc không có API Key, hệ thống tự động fallback sang Rule-based Mock.
# ------------------------------------------------------------------------------
# Bật/tắt toàn bộ tính năng AI (true / false)
AI_ENABLED=true

# Loại AI Provider: 'qwen', 'groq', hoặc 'mock'
AI_PROVIDER=mock

# ------------------------------------------------------------------------------
# 2.1 Cấu hình Qwen3-8B (HuggingFace: Qwen/Qwen3-8B)
# Tương thích chuẩn OpenAI API (vLLM, Ollama, LM Studio, TGI)
# Ví dụ chạy với Ollama: ollama run qwen3:8b (http://localhost:11434/v1)
# Ví dụ chạy với vLLM: vllm serve Qwen/Qwen3-8B --port 8000 (http://localhost:8000/v1)
# ------------------------------------------------------------------------------
QWEN_API_BASE=http://localhost:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=Qwen/Qwen3-8B
QWEN_TIMEOUT_SEC=15.0

# Groq Cloud API Key (Đăng ký miễn phí tại https://console.groq.com)
# Để trống nếu muốn chạy ở chế độ 100% Ngoại tuyến / Mock Provider
GROQ_API_KEY=

# Mô hình ngôn ngữ lớn trên Groq
# Đề xuất: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Thời gian chờ tối đa (giây) khi gọi API ngoài trước khi fallback sang offline
AI_TIMEOUT_SEC=12.0

# ------------------------------------------------------------------------------
# 3. Cấu hình Máy chủ Dịch vụ Backend
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
